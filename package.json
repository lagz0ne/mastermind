{
	"name": "mastermind",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"check": "biome ci . && turbo run typecheck test build",
		"dev": "turbo run dev",
		"build": "turbo run build",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"lint": "biome check .",
		"format": "biome check --write .",
		"ship": "scripts/ship.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@types/bun": "^1.4.4",
		"turbo": "^2.11.10",
		"typescript": "^7.0.2"
	},
	"packageManager": "bun@1.4.4"
}
